# Get a key at https://console.anthropic.com  (Settings > API Keys)
ANTHROPIC_API_KEY=sk-ant-paste-yours-here

# Optional
# JARVIS_MODEL=claude-haiku-5-5
# JARVIS_ADDRESS_AS=sir

# Optional: lets "what's the weather" work without naming a city
# JARVIS_CITY=
# JARVIS_REGION=
# JARVIS_COUNTRY=
# JARVIS_TIMEZONE=

# Voice: kokoro (default, free, local), elevenlabs (most human, paid), edge, sapi
# JARVIS_TTS=kokoro
# JARVIS_VOICE=bm_lewis           # also try bm_fable, bm_george, bm_daniel
# ULTRON_VOICE=bm_lewis           # also try am_onyx, am_fenrir
# JARVIS_VOICE_SPEED=1.05

# ElevenLabs (only if JARVIS_TTS=elevenlabs). Key from elevenlabs.io
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ULTRON_ELEVENLABS_VOICE_ID=

# Show Jarvis's reasoning in the app (slightly slower to start talking when on)
# JARVIS_SHOW_REASONING=true

# Speech recognition. Accurate pass: auto (default), small.en, medium.en, distil-large-v3, large-v3-turbo
# JARVIS_WHISPER=auto
# JARVIS_WHISPER_FAST=tiny.en
# JARVIS_WHISPER_THREADS=4
# Words he should recognise (apps, games, names)
# JARVIS_VOCAB=Spotify, Discord, Valorant, Elden Ring

# Global hotkeys (work from any app, even in a game)
# JARVIS_MUTE_HOTKEY=ctrl+alt+m
# JARVIS_APPROVE_HOTKEY=ctrl+alt+y
# JARVIS_DENY_HOTKEY=ctrl+alt+n

# Reading files: every local drive by default. false = only your user folder.
# JARVIS_READ_ANYWHERE=true

# How long a pause (seconds) ends your sentence. Raise if he cuts you off.
# JARVIS_PAUSE=1.5

# Webcam (only used when you ask him to look)
# JARVIS_CAMERA=true
# JARVIS_CAMERA_INDEX=0

# Small always-on-top widget in the top-right corner while the main window is minimized
# JARVIS_MINI=true
# Things he opens while you are in another app open BEHIND it so you keep focus
# JARVIS_KEEP_FOCUS=true

# Spoken heads-ups about battery, RAM, disk space
# JARVIS_ALERTS=true

# Path to blender.exe, only if he can't find Blender on his own
# JARVIS_BLENDER=C:\Program Files\Blender Foundation\Blender 4.2\blender.exe

# --- Blender and Unreal modes: each unlocks with its own AI key (Claude sk-ant-, OpenRouter sk-or- or OpenAI sk-).
# Easier: Studio (the cube button) or the first-run card. Model is optional (empty = the best one the key can use).
# BLENDER_AI_KEY=
# BLENDER_AI_MODEL=
# UNREAL_AI_KEY=
# UNREAL_AI_MODEL=

# --- cloud speech recognition (optional; the best speed fix on slower PCs). Free account at console.groq.com
# GROQ_API_KEY=

# --- speed
# Everyday commands (pause, volume 30, open Spotify, what time is it...) run instantly with no AI call
# JARVIS_INSTANT=true
# Simple requests go to this faster model; empty = always use JARVIS_MODEL
# JARVIS_FAST_MODEL=claude-haiku-5-5
# Careful transcription runs while you talk (only for speech aimed at him)
# JARVIS_LIVE_TRANSCRIBE=true
# Pre-recorded "On it." the instant a slow request starts
# JARVIS_INSTANT_ACK=true
# Voice model: auto (setup picks the faster one on your PC), full, or lite
# JARVIS_KOKORO=auto
# Answer as soon as a sentence is clearly finished instead of waiting out the full pause
# JARVIS_SMART_PAUSE=true
# Seconds of quiet before he checks whether you're done (raise if he jumps in too early)
# JARVIS_EARLY_PAUSE=0.55
# Careful-pass search width: 0 = auto (5 on GPU, 3 on CPU), 5 = most accurate, slower on CPU
# JARVIS_WHISPER_BEAM=0
# Shorter answers and quiet heads-ups while you're in a fullscreen game or video
# JARVIS_GAME_MODE=true

# --- hearing
# Cancel his own voice out of the mic so you can talk over him on speakers
# JARVIS_ECHO_CANCEL=true
# Speech detector sensitivity 0..1 (raise if noise triggers him, lower if he misses quiet speech)
# JARVIS_VAD=0.5

# --- Spotify (optional, see README): your app's Client ID from developer.spotify.com
# SPOTIFY_CLIENT_ID=

# --- phone remote (optional, see README)
# JARVIS_PHONE=false

# Started with Windows: seconds to wait after login before he loads
# JARVIS_STARTUP_DELAY=10

# A briefing the first time you start or wake the PC each day
# JARVIS_MORNING_BRIEFING=true
# Headlines for the briefing (any RSS feed; empty = no news)
# JARVIS_NEWS_RSS=https://www.cbc.ca/webfeed/rss/rss-topstories

# Read new Discord messages out loud as they arrive
# JARVIS_DISCORD_READ=true

# Email, read-only (optional; README "Email"). Use an APP password, never your real one.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Say new emails out loud as they arrive (or say "tell me when I get emails")
# JARVIS_EMAIL_ANNOUNCE=false

# Netflix: auto (app if installed), web, or app. Tracking what you watch on this PC: true/false
# JARVIS_NETFLIX=auto
# JARVIS_NETFLIX_TRACK=true

# Discord bot (optional; README "Discord bot"). The token is a password: only ever put it here.
DISCORD_BOT_TOKEN=
# Your Discord user ID (Developer Mode > right-click your name > Copy User ID): no rate limits, "DM me" works
DISCORD_OWNER_ID=
# Who he answers on Discord: everyone (rate limited), owner (only you), off (read/send only)
# DISCORD_BOT_REPLY=everyone
# Longest spoken answer before he finishes his current idea and leaves the rest on screen (words)
# JARVIS_MAX_WORDS=150

# Daily spending limit for Claude in dollars (an estimate; 0 = no limit)
# JARVIS_DAILY_BUDGET=5
# How many days of conversation memory to keep
# JARVIS_HISTORY_DAYS=365
